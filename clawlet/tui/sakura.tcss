/* Sakura theme for the Clawlet TUI. All widget chrome lives here. */

$sakura-bg: #14101A;
$sakura-pink-panel: #1E1826;
$sakura-pink-panel-alt: #241C2E;
$sakura-text: #F5EDF3;
$sakura-muted: #A898AC;
$sakura-pink: #FF69B4;
$sakura-pink-light: #FFB7C5;
$sakura-pink-accent-dark: #8E2F5C;
$sakura-border: #4A3442;
$sakura-ok: #34D399;
$sakura-warn: #FBBF24;
$sakura-err: #F87171;
$sakura-cyan: #7DD3FC;

Screen {
    background: $sakura-bg;
    color: $sakura-text;
}

Header {
    background: $sakura-pink-panel-alt;
    color: $sakura-pink-light;
}

Footer {
    background: $sakura-pink-panel-alt;
    color: $sakura-muted;
}

#chat-panel {
    width: 1fr;
    height: auto;
    padding: 0 1;
}

#chat-scroll {
    height: 1fr;
}

/* ── agent activity: draft bubble ─────────────────────────────── */
#draft-bubble {
    max-height: 8;
    height: auto;
    display: none;
    background: $sakura-pink-panel;
    border: round $sakura-border;
    margin: 0 1;
    padding: 0 1;
}

#draft-text {
    color: $sakura-text;
}

/* ── agent activity: thinking trace ───────────────────────────── */
#thinking-trace {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}

#thinking-trace > CollapsibleTitle {
    color: $sakura-pink;
    text-style: bold;
    padding: 0 1;
}

#thinking-trace > CollapsibleTitle:focus {
    background: $sakura-pink-accent-dark;
    color: $sakura-pink-light;
}

#trace-body {
    color: $sakura-muted;
    padding: 0 2;
}

/* ── heartbeat task rows ───────────────────────────────────────── */
#heartbeat-panel {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}

#heartbeat-panel > CollapsibleTitle {
    color: $sakura-muted;
    padding: 0 1;
}

#heartbeat-panel > CollapsibleTitle:focus {
    background: $sakura-pink-accent-dark;
    color: $sakura-pink-light;
}

#hb-body {
    color: $sakura-muted;
    padding: 0 2;
}

/* ── context meter ─────────────────────────────────────────────── */
#context-meter {
    height: 1;
    background: $sakura-pink-panel;
    display: none;
    margin: 0 1;
}

#context-meter > .bar--bar {
    color: $sakura-pink;
    background: $sakura-pink-panel;
}

#context-meter > .bar--complete {
    background: $sakura-pink-accent-dark;
}

/* ── status rail ───────────────────────────────────────────────── */
#status-bar {
    height: 1;
    color: $sakura-muted;
    padding: 0 1;
}

#input-bar {
    height: auto;
}

#command-input {
    background: $sakura-bg;
    color: $sakura-text;
    border: tall $sakura-pink-accent-dark;
}

#command-input:focus {
    border: tall $sakura-pink;
}

#slash-scroll {
    max-height: 8;
    height: auto;
    display: none;
}

#slash-hint {
    height: auto;
    color: $sakura-muted;
    padding: 0 1;
}

/* ── compact tool rows ─────────────────────────────────────────── */
.tool-row {
    background: transparent;
    border: none;
    height: auto;
    padding: 0;
    margin: 0;
}

.tool-row > CollapsibleTitle {
    color: $sakura-cyan;
    padding: 0;
}

.tool-row.status-success > CollapsibleTitle {
    color: $sakura-ok;
}

.tool-row.status-failed > CollapsibleTitle {
    color: $sakura-err;
}

.tool-row.status-running > CollapsibleTitle {
    color: $sakura-pink;
}

.tool-row.status-requires-approval > CollapsibleTitle {
    color: $sakura-warn;
}

.tool-row > Contents {
    color: $sakura-muted;
    padding: 0 2 1 2;
}

.panel-title {
    color: $sakura-pink;
    text-style: bold;
}

.warning-title {
    color: $sakura-warn;
    text-style: bold;
}

.success { color: $sakura-ok; }
.warning { color: $sakura-warn; }
.cyan { color: $sakura-cyan; }
.error { color: $sakura-err; }
.muted { color: $sakura-muted; }

ApprovalModal {
    align: center middle;
}

ApprovalModal > #approval-box {
    width: 68;
    height: auto;
    max-height: 28;
    background: $sakura-pink-panel-alt;
    border: heavy $sakura-warn;
    padding: 1 2;
}

ApprovalModal .approval-tool {
    color: $sakura-pink-light;
    text-style: bold;
    margin-top: 1;
}

ApprovalModal .approval-args {
    color: $sakura-muted;
    margin-top: 1;
}

ApprovalModal .approval-consequence {
    color: $sakura-text;
    margin-top: 1;
}

ApprovalModal .approval-token {
    color: $sakura-muted;
    margin-top: 1;
}

ApprovalModal Horizontal {
    margin-top: 1;
    height: auto;
}

#replay-screen, #context-screen {
    background: $sakura-bg;
    color: $sakura-text;
    padding: 1 2;
}

#replay-id {
    background: $sakura-bg;
    color: $sakura-text;
    border: tall $sakura-pink-accent-dark;
    margin-bottom: 1;
}

#replay-id:focus {
    border: tall $sakura-pink;
}

#replay-log, #context-log {
    height: 1fr;
    background: $sakura-pink-panel;
    border: round $sakura-border;
    padding: 0 1;
}

#session-search {
    background: $sakura-bg;
    color: $sakura-text;
    border: tall $sakura-pink-accent-dark;
    margin-bottom: 1;
}

#session-search:focus {
    border: tall $sakura-pink;
}

#sessions-split {
    height: 1fr;
}

#session-list {
    height: 40%;
    background: $sakura-pink-panel;
    border: round $sakura-border;
}

#session-view {
    height: 1fr;
    background: $sakura-pink-panel;
    border: round $sakura-border;
    padding: 0 1;
}

.screen-hint {
    color: $sakura-muted;
    margin-top: 1;
}